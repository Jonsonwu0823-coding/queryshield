# Placeholders only. Create the real .env with:  python scripts/new_env.py
# (it writes random values, never prints them, and does not overwrite an existing .env).
# .env is ignored by git. Model keys do not go here: set them in the shell that runs docker compose.

# PostgreSQL superuser (used by the db and setup services only). It is read when the data
# volume is first created; changing it later does not change the password inside an existing volume.
POSTGRES_PASSWORD=<generated>

# The two application roles. setup sets both passwords from these values on every run.
QUERYSHIELD_ADMIN_PASSWORD=<generated>
QUERYSHIELD_RO_PASSWORD=<generated>

# Four different bearer tokens: tenant A and B, requester and approver.
QUERYSHIELD_TOKEN_A_REQUESTER=<generated>
QUERYSHIELD_TOKEN_A_APPROVER=<generated>
QUERYSHIELD_TOKEN_B_REQUESTER=<generated>
QUERYSHIELD_TOKEN_B_APPROVER=<generated>

# Optional: the host port for the service (bound to 127.0.0.1 only).
# QUERYSHIELD_HTTP_PORT=8000
