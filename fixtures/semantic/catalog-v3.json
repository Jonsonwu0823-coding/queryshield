  "clarifications": [
    {
      "id": "clarify.metric_basis",
      "condition": "问题只用了含糊的金额说法（如销售额、营业额、收入、营收），没有写明支付订单总额还是退款后净额。",
      "question": "你要看支付订单总额（gross_fen），还是退款后净额（net_fen）？",
      "allowed_values": [
        "gross_fen",
        "net_fen"
      ],
      "ambiguous_phrases": [
        "销售额",
        "营业额",
        "收入",
        "营收"
      ],
      "ask_markers": [
        "clarify.metric_basis",
        "口径",
        "金额",
        "总额",
        "统计方式"
      ],
      "values": [
        {
          "value": "gross_fen",
          "metric": "gross_fen"
        },
        {
          "value": "net_fen",
          "metric": "net_fen"
        }
      ],
      "resolution": "只有用户明确选择一个 metric_id 后才继续查询；否则保持 WAITING_USER。"
    },
    {
      "id": "clarify.order_status_scope",
      "condition": "问题要求订单数量（如订单数、订单数量），但没有说明只统计已支付订单，还是要包含已取消订单。",
      "question": "请确认订单范围：只统计已支付（paid），还是需要包含已取消（cancelled）？",
      "allowed_values": [
        "paid",
        "cancelled",
        "all"
      ],
      "ambiguous_phrases": [
        "订单数",
        "订单数量",
        "多少订单"
      ],
      "ask_markers": [
        "clarify.order_status_scope",
        "取消",
        "订单状态",
        "订单范围"
      ],
      "values": [
        {
          "value": "paid",
          "metric": "paid_count",
          "phrases": [
            "已支付订单",
            "已支付",
            "已付款",
            "只统计已支付"
          ],
          "definition": "只统计 status=paid 的订单；已取消订单不计入。"
        },
        {
          "value": "cancelled",
          "phrases": [
            "已取消",
            "取消的订单",
            "cancelled"
          ],
          "definition": "只统计 status=cancelled 的订单。",
          "supported": false,
          "unsupported_note": "目前只核实已支付订单的数量；已取消订单或全部订单没有受支持的统计口径，所以没有执行查询。"
        },
        {
          "value": "all",
          "phrases": [
            "全部订单",
            "所有订单",
            "包含已取消",
            "包括取消"
          ],
          "definition": "统计全部状态的订单（已支付和已取消）。",
          "supported": false,
          "unsupported_note": "目前只核实已支付订单的数量；已取消订单或全部订单没有受支持的统计口径，所以没有执行查询。"
        }
      ],
      "resolution": "paid 才能直接绑定 paid_count；其它范围必须先得到明确的受支持查询口径，不能让模型自行扩大指标定义。"
    },
    {
      "id": "clarify.refund_window",
      "condition": "单一取值：退款固定按同一 UTC 窗口、只计该窗口内已支付订单的退款；服务端不追问，而在回答里写明这一前提。",
      "question": "请确认退款是否使用同一 UTC 窗口，并且只计算该窗口内已支付订单的退款？",
      "allowed_values": [
        "same_window_paid_orders"
      ],
      "ambiguous_phrases": [],
      "ask_markers": [
        "clarify.refund_window",
