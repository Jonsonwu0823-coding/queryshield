        "哪些退款",
        "退款范围"
      ],
      "values": [
        {
          "value": "same_window_paid_orders",
          "metric": "net_fen",
          "phrases": [
            "同一窗口",
            "同一 UTC 窗口",
            "窗口内已支付订单的退款",
            "same_window_paid_orders"
          ],
          "definition": "退款按同一 UTC 窗口内、已支付订单的退款计算。"
        }
      ],
      "resolution": "只有一个受支持的口径；净额结果按它计算，并在回答里写明。"
    }
  ]
