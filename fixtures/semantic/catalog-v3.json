      "id": "field.orders.order_id",
      "kind": "field",
      "text": "orders.order_id 是订单标识；数据库没有 orders.id，订单关联和结果排序必须使用 order_id。",
      "source_id": "commerce-v1",
      "version": "commerce-v1",
